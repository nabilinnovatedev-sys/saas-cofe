# Secrets des Edge Functions — à définir avec `supabase secrets set --env-file ...`
# Ces valeurs ne doivent jamais être préfixées VITE_ ou EXPO_PUBLIC_.
TRACKING_SECRET=generez_au_moins_32_octets_aleatoires
ABUSE_HASH_SECRET=generez_au_moins_32_octets_aleatoires
BOOTSTRAP_SECRET=secret_temporaire_pour_le_premier_admin
DEVICE_ENCRYPTION_KEY=base64_de_32_octets
PUSH_WORKER_SECRET=secret_du_cron_push
PUBLIC_WEB_ORIGIN=https://menu.votre-domaine.ma
WAITER_APP_REDIRECT=cafe-waiter://auth
# SUPABASE_URL, SUPABASE_ANON_KEY et SUPABASE_SERVICE_ROLE_KEY sont injectés
# automatiquement par Supabase dans les fonctions déployées.
